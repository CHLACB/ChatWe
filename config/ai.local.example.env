APP_AI_MODE=langgraph

# 聊天回复模型。Base URL 按服务商填写：
# - 阿里云百炼 OpenAI 兼容： https://dashscope.aliyuncs.com/compatible-mode/v1
# - DeepSeek 官方接口：       https://api.deepseek.com
APP_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_AI_API_KEY=
APP_AI_MODEL=deepseek-v4-flash

# 微信私聊建议先稳一点：0.3 到 0.8。想更活再慢慢上调。
APP_AI_TEMPERATURE=0.65
APP_AI_MAX_TOKENS=800
APP_AI_TIMEOUT_SECONDS=30
APP_AI_PROMPT_PATH=./config/prompts/system.wechat_turn.md
APP_AI_STYLE_PATH=./config/prompts/styles/natural_short.md
# 默认只分析并展示 AI 建议，不自动创建发送任务。需要自动发时在前端勾选或改 true。
APP_AUTO_SEND_ENABLED=false
APP_AI_PROACTIVE_MODE=off
APP_AI_MAX_MESSAGES_PER_TURN=2
APP_AI_STRICT_TURN_JSON=true
APP_AI_TURN_QUIET_SECONDS=5.0
APP_AI_DUPLICATE_GUARD_SECONDS=120.0
APP_DIAGNOSTICS_CONTEXT_CHARS=1200
APP_AI_CORE_PROMPT_PATH=./config/prompts/system.core.md
APP_AI_SYSTEM_PROMPT=你是一个微信私聊助手。请只输出 JSON，不要输出分析过程。
# 服务商专用请求体参数。不了解就留空；需要时填 JSON object。
APP_AI_EXTRA_BODY=

# 图片/表情包识别专用视觉模型。它只负责把媒体转成文字描述，不参与聊天回复。
APP_VISION_AI_ENABLED=true
APP_VISION_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_VISION_AI_API_KEY=
APP_VISION_AI_MODEL=qwen3-vl-plus
APP_VISION_AI_TEMPERATURE=0.1
APP_VISION_AI_MAX_TOKENS=300
APP_VISION_AI_TIMEOUT_SECONDS=30
APP_VISION_AI_SYSTEM_PROMPT=你是微信图片和表情包识别器。只描述图片/表情包里能看见的内容、文字和表达的情绪。不要生成聊天回复。
APP_VISION_AI_EXTRA_BODY=

# 语音识别专用模型。它只负责把对方语音转成文字，不参与聊天回复。
APP_SPEECH_AI_ENABLED=false
APP_SPEECH_AI_BASE_URL=https://api.openai.com/v1
APP_SPEECH_AI_API_KEY=
APP_SPEECH_AI_MODEL=gpt-4o-mini-transcribe
APP_SPEECH_AI_LANGUAGE=zh
APP_SPEECH_AI_TIMEOUT_SECONDS=30
APP_SPEECH_AI_PROMPT=这是一条微信语音消息，请转写为简体中文。

APP_LANGGRAPH_NODES_PATH=./config/langgraph_nodes.local.json
